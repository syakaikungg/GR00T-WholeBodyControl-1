<mujoco model="g1_43dof scene">
  <include file="g1_29dof_with_hand.xml"/>
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="wood_tex" builtin="flat" rgb1="0.6 0.4 0.2" width="64" height="64"/>
    <material name="wood" texture="wood_tex" rgba="0.7 0.5 0.3 1"/>
    <material name="wall_mat" rgba="0.85 0.85 0.80 1"/>
    <material name="red_ball" rgba="0.9 0.2 0.1 1"/>
    <material name="green_obj" rgba="0.2 0.8 0.3 1"/>
    <material name="blue_obj" rgba="0.2 0.3 0.9 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <light pos="2 2 2.5" dir="-0.5 -0.5 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Site -->
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>
    <camera name="third_person" pos="2.0 -2.0 1.5" xyaxes="0.707 0.707 0.0 -0.354 0.354 0.866"/>

    <!-- Table in front of the robot -->
    <body name="table" pos="0.7 0 0">
      <geom name="table_top" type="box" size="0.3 0.4 0.02" pos="0 0 0.65" material="wood" mass="10"/>
      <geom name="table_leg1" type="cylinder" size="0.025" fromto="-0.25 -0.35 0 -0.25 -0.35 0.63" material="wood"/>
      <geom name="table_leg2" type="cylinder" size="0.025" fromto="0.25 -0.35 0  0.25 -0.35 0.63" material="wood"/>
      <geom name="table_leg3" type="cylinder" size="0.025" fromto="-0.25  0.35 0 -0.25  0.35 0.63" material="wood"/>
      <geom name="table_leg4" type="cylinder" size="0.025" fromto="0.25  0.35 0  0.25  0.35 0.63" material="wood"/>
    </body>

    <!-- Objects on the table -->
    <body name="red_ball" pos="0.65 0.1 0.70">
      <freejoint/>
      <geom type="sphere" size="0.03" material="red_ball" mass="0.1"/>
    </body>
    <body name="green_box" pos="0.75 -0.1 0.70">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" material="green_obj" mass="0.15"/>
    </body>
    <body name="blue_cylinder" pos="0.6 -0.05 0.71">
      <freejoint/>
      <geom type="cylinder" size="0.02 0.04" material="blue_obj" mass="0.12"/>
    </body>

    <!-- Wall behind -->
    <geom name="back_wall" type="box" size="0.05 3 1.5" pos="-2 0 1.5" material="wall_mat"/>
    <!-- Side walls -->
    <geom name="left_wall" type="box" size="2 0.05 1.5" pos="0 3 1.5" material="wall_mat"/>
    <geom name="right_wall" type="box" size="2 0.05 1.5" pos="0 -3 1.5" material="wall_mat"/>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
